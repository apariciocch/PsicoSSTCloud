# =====================================
# SERVIDOR
# =====================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# =====================================
# POCKETBASE
# =====================================
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=secure_password
POCKETBASE_DATA_DIR=./pb_data

# =====================================
# JWT
# =====================================
JWT_SECRET=your_super_secret_key_min_32_characters_long_here_xxxx
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# =====================================
# BASE DE DATOS
# =====================================
DATABASE_URL=file:./pb_data/data.db

# =====================================
# SEGURIDAD
# =====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.example.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# =====================================
# LOGS
# =====================================
LOG_LEVEL=info
LOG_FORMAT=json

# =====================================
# EMAIL/SMTP
# =====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=app@example.com
SMTP_PASSWORD=app_password
SMTP_FROM=noreply@empresa.com

# =====================================
# ARCHIVOS
# =====================================
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,xls,xlsx,doc,docx,mp4
STORAGE_PATH=./storage/uploads

# =====================================
# PAGINACION
# =====================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
